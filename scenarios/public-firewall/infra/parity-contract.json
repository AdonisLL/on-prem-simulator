  "requiredControls": [
    "Azure Firewall Standard",
    "forced-tunnel route tables",
    "no VM public IP",
    "no public RDP",
    "temporary PaaS access restricted to deployer and firewall egress IPs"
  ],
  "sharedOutputs": [
    "firewall",
    "key vault",
    "staging storage",
    "public endpoints",
    "private inventory"
  ]
